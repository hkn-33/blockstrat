# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Domain pointing at this VPS (DNS A record). Caddy issues the HTTPS certificate for it.
API_DOMAIN=api.example.com

# Frontend origins allowed to call the API (comma separated), e.g. the Vercel URL.
FRONTEND_ORIGINS=https://blockstrat.vercel.app

# Groq key for the AI chat (console.groq.com). Leave empty to run without AI (the chat says the AI is resting).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# AI limits; keep the daily cap below your Groq plan's daily request limit.
AI_REQUESTS_PER_IP_PER_HOUR=10
AI_REQUESTS_PER_DAY=200

# Limits per client address an hour for the endpoints that cost the server work.
BACKTESTS_PER_IP_PER_HOUR=1500
SEARCHES_PER_IP_PER_HOUR=30
CHARTS_PER_IP_PER_HOUR=300
