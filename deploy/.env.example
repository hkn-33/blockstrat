# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Domain pointing at this VPS (DNS A record). Caddy issues the HTTPS certificate for it.
API_DOMAIN=api.example.com

# Frontend origins allowed to call the API (comma separated), e.g. the Vercel URL.
FRONTEND_ORIGINS=https://blockstrat.vercel.app

# Gemini key for the AI chat. Leave empty to run without AI (the chat says the AI is resting).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# AI limits; keep the daily cap below your Gemini free-tier daily limit.
AI_REQUESTS_PER_IP_PER_HOUR=10
AI_REQUESTS_PER_DAY=200
