# Copy to backend/.env for local development (`cp .env.example .env`); the backend loads it on start.
# backend/.env is git-ignored: never commit it. In production set these in Coolify instead.

# Groq key for the AI chat, from https://console.groq.com/keys. Leave empty to run without AI.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Frontend addresses allowed to call the API (comma separated, no trailing slash).
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Limits per client address an hour, and the AI's daily total (keep it under your Groq plan's daily requests).
AI_REQUESTS_PER_IP_PER_HOUR=10
AI_REQUESTS_PER_DAY=200
BACKTESTS_PER_IP_PER_HOUR=1500
SEARCHES_PER_IP_PER_HOUR=30
CHARTS_PER_IP_PER_HOUR=300

# 1 shows the interactive API docs at /docs; leave it off in production.
API_DOCS=0
